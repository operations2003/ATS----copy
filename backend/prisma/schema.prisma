generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  RECRUITER
  ADMIN
  MEMBER
  TEAM_LEADER
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique
  password            String
  name                String?
  role                UserRole     @default(MEMBER)
  isActive            Boolean      @default(true) @map("is_active")
  teamId              String?      @map("team_id") @db.Uuid
  team                String?      @default("General")
  customRole          String?      @map("custom_role")
  organizationId      String?      @default("org-tasknera") @map("organization_id")
  allowJdUpload       Boolean      @default(true) @map("allow_jd_upload")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  jobs                Job[]
  candidates          Candidate[]
  createdEvaluations  Evaluation[] @relation("CreatedEvaluations")
  assignedEvaluations Evaluation[] @relation("AssignedEvaluations")
  evaluatedEvaluations Evaluation[] @relation("EvaluatedEvaluations")
  auditLogs           AuditLog[]
  bulkBatches         BulkUploadBatch[]


  @@index([role], map: "idx_users_role")
  @@index([organizationId], map: "idx_users_organization_id")
  @@map("users")
}

model Job {
  id                    String      @id @default(uuid()) @db.Uuid
  client                String
  position              String
  jd_file_url           String?     @map("jd_file_url")
  jd_text               String?     @map("jd_text")
  original_jd           String?     @map("original_jd")
  normalized_jd         Json?       @map("normalized_jd")
  ai_processing_status  String?     @default("PENDING") @map("ai_processing_status")
  ai_model              String?     @map("ai_model")
  ai_processed_at       DateTime?   @map("ai_processed_at")
  location              String?
  work_mode             String?     @map("work_mode")
  salary                String?
  status                String      @default("draft")
  evaluation_profile_id String?     @map("evaluation_profile_id") @db.Uuid
  created_by            String      @map("created_by") @db.Uuid
  organizationId        String?     @default("org-tasknera") @map("organization_id")
  publicToken           String?     @unique @map("public_token")
  isPublicLinkActive    Boolean     @default(true) @map("is_public_link_active")
  created_at            DateTime    @default(now()) @map("created_at")
  updated_at            DateTime    @updatedAt @map("updated_at")

  user         User                   @relation(fields: [created_by], references: [id], onDelete: Cascade)
  requirements Requirement[]
  candidates   Candidate[]
  applications CandidateApplication[]
  evaluations  Evaluation[]
  bulkBatches  BulkUploadBatch[]

  @@index([created_by], map: "idx_jobs_created_by")
  @@index([status], map: "idx_jobs_status")
  @@index([organizationId], map: "idx_jobs_organization_id")
  @@map("jobs")
}

model Requirement {
  id                  String   @id @default(uuid()) @db.Uuid
  job_id              String   @map("job_id") @db.Uuid
  requirement         String
  category            String?
  weight              Float    @default(1.0)
  is_mandatory        Boolean  @default(false) @map("is_mandatory")
  evidence_required   Boolean  @default(false) @map("evidence_required")
  recruiter_confirmed Boolean  @default(false) @map("recruiter_confirmed")
  source_evidence     String?  @map("source_evidence")
  needs_verification  Boolean  @default(false) @map("needs_verification")
  aliases             String[] @default([])
  context             String?
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id], map: "idx_requirements_job_id")
  @@index([category], map: "idx_requirements_category")
  @@map("requirements")
}

enum ParsingStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

model Candidate {
  id               String                 @id @default(uuid()) @db.Uuid
  job_id           String?                @map("job_id") @db.Uuid
  organizationId   String?                @default("org-tasknera") @map("organization_id")
  name             String?
  email            String?
  phone            String?
  location         String?
  total_experience String?                @map("total_experience")
  current_title    String?                @map("current_title")
  current_company  String?                @map("current_company")
  summary          String?
  resume_file_url  String?                @map("resume_file_url")
  raw_text         String?                @map("raw_text")
  file_hash        String?                @map("file_hash")
  parsing_status   ParsingStatus          @default(UPLOADED) @map("parsing_status")
  error_message    String?                @map("error_message")
  source           String?                @default("manual_upload")
  created_by       String                 @map("created_by") @db.Uuid
  created_at       DateTime               @default(now()) @map("created_at")
  updated_at       DateTime               @updatedAt @map("updated_at")

  job            Job?                     @relation(fields: [job_id], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [created_by], references: [id], onDelete: Cascade)
  applications   CandidateApplication[]
  evaluations    Evaluation[]
  experiences    CandidateExperience[]
  education      CandidateEducation[]
  skills         CandidateSkill[]
  certifications CandidateCertification[]
  languages      CandidateLanguage[]
  projects       CandidateProject[]
  bulkItems      BulkCvItem[]

  @@index([job_id], map: "idx_candidates_job_id")
  @@index([created_by], map: "idx_candidates_created_by")
  @@index([file_hash], map: "idx_candidates_file_hash")
  @@index([organizationId], map: "idx_candidates_organization_id")
  @@index([source], map: "idx_candidates_source")
  @@map("candidates")
}

model CandidateApplication {
  id           String    @id @default(uuid()) @db.Uuid
  job_id       String    @map("job_id") @db.Uuid
  candidate_id String    @map("candidate_id") @db.Uuid
  stage        String    @default("SOURCED")
  match_score  Float?    @map("match_score")
  status       String    @default("active")
  created_at   DateTime  @default(now()) @map("created_at")
  updated_at   DateTime  @updatedAt @map("updated_at")

  job       Job       @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@unique([job_id, candidate_id], map: "uniq_job_candidate")
  @@index([job_id], map: "idx_app_job_id")
  @@index([candidate_id], map: "idx_app_candidate_id")
  @@map("candidate_applications")
}

model CandidateExperience {
  id              String   @id @default(uuid()) @db.Uuid
  candidate_id    String   @map("candidate_id") @db.Uuid
  company         String?
  title           String?
  start_date      String?  @map("start_date")
  end_date        String?  @map("end_date")
  duration        String?
  description     String?
  source_evidence String?  @map("source_evidence")
  created_at      DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id], map: "idx_candidate_experience_candidate_id")
  @@map("candidate_experiences")
}

model CandidateEducation {
  id           String   @id @default(uuid()) @db.Uuid
  candidate_id String   @map("candidate_id") @db.Uuid
  degree       String?
  institution  String?
  field        String?
  start_year   Int?     @map("start_year")
  end_year     Int?     @map("end_year")
  created_at   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id], map: "idx_candidate_education_candidate_id")
  @@map("candidate_educations")
}

model CandidateSkill {
  id           String   @id @default(uuid()) @db.Uuid
  candidate_id String   @map("candidate_id") @db.Uuid
  skill        String
  created_at   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id], map: "idx_candidate_skill_candidate_id")
  @@map("candidate_skills")
}

model CandidateCertification {
  id            String   @id @default(uuid()) @db.Uuid
  candidate_id  String   @map("candidate_id") @db.Uuid
  certification String
  created_at    DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id], map: "idx_candidate_certification_candidate_id")
  @@map("candidate_certifications")
}

model CandidateLanguage {
  id           String   @id @default(uuid()) @db.Uuid
  candidate_id String   @map("candidate_id") @db.Uuid
  language     String
  created_at   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id], map: "idx_candidate_language_candidate_id")
  @@map("candidate_languages")
}

model CandidateProject {
  id           String   @id @default(uuid()) @db.Uuid
  candidate_id String   @map("candidate_id") @db.Uuid
  name         String?
  description  String?
  technologies String[] @default([])
  created_at   DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id], map: "idx_candidate_project_candidate_id")
  @@map("candidate_projects")
}

model Evaluation {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @default("org-tasknera") @map("organization_id")
  candidateId         String   @map("candidate_id") @db.Uuid
  jobId               String   @map("job_id") @db.Uuid
  candidateJobId      String?  @map("candidate_job_id")
  createdByUserId     String   @map("created_by_user_id") @db.Uuid
  evaluatedBy         String?  @map("evaluated_by") @db.Uuid
  assignedToUserId    String?  @map("assigned_to_user_id") @db.Uuid
  score               Float
  atsScore            Float?   @map("ats_score")
  matchLevel          String?  @map("match_level")
  mandatoryCompliance String?  @map("mandatory_compliance")
  mandatoryFailed     Boolean  @default(false) @map("mandatory_failed")
  decision            String   @default("REVIEW")
  status              String   @default("COMPLETED")
  auditData           Json?    @map("audit_data")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  creator   User      @relation("CreatedEvaluations", fields: [createdByUserId], references: [id], onDelete: Cascade)
  evaluator User?     @relation("EvaluatedEvaluations", fields: [evaluatedBy], references: [id], onDelete: SetNull)
  assignee  User?     @relation("AssignedEvaluations", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId], map: "idx_evaluations_org_id")
  @@index([createdByUserId], map: "idx_evaluations_creator")
  @@index([evaluatedBy], map: "idx_evaluations_evaluated_by")
  @@index([assignedToUserId], map: "idx_evaluations_assignee")
  @@index([jobId], map: "idx_evaluations_job_id")
  @@index([candidateId], map: "idx_evaluations_candidate_id")
  @@index([candidateId, jobId], map: "idx_evaluations_cand_job")
  @@map("evaluations")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Organization {
  id                  String      @id @default(uuid())
  name                String
  companyEmail        String?     @map("company_email")
  contactPhone        String?     @map("contact_phone")
  address             String?
  status              OrgStatus   @default(ACTIVE)
  subscriptionPlan    String      @default("STARTER") @map("subscription_plan")
  billingCycle        String      @default("monthly") @map("billing_cycle")
  subscriptionStart   DateTime    @default(now()) @map("subscription_start")
  subscriptionExpiry  DateTime?   @map("subscription_expiry")

  maxUsers            Int         @default(5) @map("max_users")
  maxRecruiters       Int         @default(5) @map("max_recruiters")
  maxActiveJobs       Int         @default(20) @map("max_active_jobs")
  maxResumesPerMonth  Int         @default(500) @map("max_resumes_per_month")
  allowJdUpload       Boolean     @default(true) @map("allow_jd_upload")

  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  auditLogs           AuditLog[]


  @@map("organizations")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id")
  userId         String?       @map("user_id") @db.Uuid
  action         String
  targetType     String?       @map("target_type")
  targetId       String?       @map("target_id")
  details        Json?
  ipAddress      String?       @map("ip_address")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId], map: "idx_audit_logs_org_id")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([action], map: "idx_audit_logs_action")
  @@map("audit_logs")
}


model BulkUploadBatch {
  id              String       @id @default(uuid()) @db.Uuid
  jobId           String?      @map("job_id") @db.Uuid
  organizationId  String       @default("org-tasknera") @map("organization_id")
  uploadedBy      String       @map("uploaded_by") @db.Uuid
  status          String       @default("PENDING")
  totalFiles      Int          @default(0) @map("total_files")
  uploadedCount   Int          @default(0) @map("uploaded_count")
  queuedCount     Int          @default(0) @map("queued_count")
  processingCount Int          @default(0) @map("processing_count")
  parsedCount     Int          @default(0) @map("parsed_count")
  scoredCount     Int          @default(0) @map("scored_count")
  failedCount     Int          @default(0) @map("failed_count")
  reviewCount     Int          @default(0) @map("review_count")
  duplicateCount  Int          @default(0) @map("duplicate_count")
  errorMessage    String?      @map("error_message")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  job             Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  items           BulkCvItem[]

  @@index([jobId], map: "idx_bulk_batches_job_id")
  @@index([organizationId], map: "idx_bulk_batches_org_id")
  @@index([uploadedBy], map: "idx_bulk_batches_uploaded_by")
  @@index([status], map: "idx_bulk_batches_status")
  @@map("bulk_upload_batches")
}

model BulkCvItem {
  id                 String          @id @default(uuid()) @db.Uuid
  batchId            String          @map("batch_id") @db.Uuid
  candidateId        String?         @map("candidate_id") @db.Uuid
  fileName           String          @map("file_name")
  fileSize           Int             @map("file_size")
  fileMime           String          @map("file_mime")
  fileHash           String?         @map("file_hash")
  storagePath        String?         @map("storage_path")
  status             String          @default("UPLOADED")
  attemptCount       Int             @default(0) @map("attempt_count")
  maxAttempts        Int             @default(3) @map("max_attempts")
  errorCode          String?         @map("error_code")
  errorMessage       String?         @map("error_message")
  diagnosticMessage  String?         @map("diagnostic_message")
  candidateName      String?         @map("candidate_name")
  candidateEmail     String?         @map("candidate_email")
  atsScore           Float?          @map("ats_score")
  validationStatus   String?         @default("PENDING") @map("validation_status")
  intermediateResult Json?           @map("intermediate_result")
  fieldWarnings      Json?           @map("field_warnings")
  lastAttemptAt      DateTime?       @map("last_attempt_at")
  completedAt        DateTime?       @map("completed_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  batch              BulkUploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  candidate          Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([batchId], map: "idx_bulk_cv_items_batch_id")
  @@index([status], map: "idx_bulk_cv_items_status")
  @@index([candidateId], map: "idx_bulk_cv_items_candidate_id")
  @@index([fileHash], map: "idx_bulk_cv_items_file_hash")
  @@index([batchId, status], map: "idx_bulk_cv_items_batch_status")
  @@map("bulk_cv_items")
}
